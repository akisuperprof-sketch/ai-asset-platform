{
  "name": "app-init",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker:generate": "npx tsx src/scripts/worker_process_generation.ts --watch",
    "worker:generate:one": "npx tsx src/scripts/worker_process_generation.ts --limit 1",
    "worker:nightly": "node scripts/worker-stage2.js --target 20 --batch 1 --sleep 120",
    "worker:test": "node scripts/worker-stage2.js --target 3 --batch 1 --sleep 120",
    "auto-producer": "node scripts/local-auto-producer.js",
    "env:check": "npx tsx src/scripts/check-env.ts",
    "env:pull": "vercel env pull .env.vercel --environment=production --yes",
    "env:backup": "cp .env.local .env.local.backup"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@google/genai": "^2.6.0",
    "@imgly/background-removal-node": "^1.4.5",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/postcss": "^4.3.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "openai": "^6.42.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "replicate": "^1.4.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^20",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jimp": "^0.22.12",
    "postcss": "^8.5.14",
    "puppeteer": "^25.0.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5"
  }
}
