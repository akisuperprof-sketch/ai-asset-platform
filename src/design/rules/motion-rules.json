{
  "forbidden_classes": [
    "bounce",
    "spin",
    "hover:-translate-y",
    "hover:scale",
    "animate-pulse",
    "duration-75",
    "duration-1000"
  ],
  "allowed_prefixes": [
    "transition-opacity",
    "transition-all",
    "animate-fade-in",
    "slide-in",
    "ease-out",
    "duration-200",
    "duration-300"
  ]
}
